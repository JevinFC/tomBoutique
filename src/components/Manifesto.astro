---
// Le manifeste, adressé au visiteur : le texte s'allume mot à mot pendant le scroll,
// et un mot reçoit un patch rouge. Tom n'apparaît que dans la signature.
// Les textes viennent de src/content/textes.json (interface d'administration, voir GUIDE.md).
import Logo from './Logo.astro';
import Patch from './Patch.astro';
import textes from '../content/textes.json';
import { typo } from '../lib/typo';

const { titre, titreRouge, sousTitre, texte, motEnRouge, signature, signatureSuite } = textes.manifeste;

// Le mot en rouge est comparé sans ponctuation ni majuscules : « lumineux » trouve « lumineux. »
const nu = (mot: string) => mot.toLocaleLowerCase('fr').replace(/[^\p{L}\p{N}'’-]/gu, '');
const cible = nu(motEnRouge ?? '');

// « cheveux » garde les mèches de Tom dans la signature : le seul arc-en-ciel de la section
const [avantCheveux, ...apresCheveux] = (signatureSuite ?? '').split('cheveux');

// La ponctuation haute (: ; ! ?) reste collée au mot précédent par une espace insécable
const mots = texte.split(/\s+/).filter(Boolean).map((mot, i) => ({
  mot,
  avant: i === 0 ? '' : /^[:;!?]$/.test(mot) ? ' ' : ' ',
  couleur: cible && nu(mot) === cible ? 'var(--accent)' : undefined,
}));
---

<section class="tom" id="manifeste" aria-labelledby="manifeste-title">
  <header class="shead">
    <span class="shead__idx">(02)</span>
    <h2 class="shead__title" id="manifeste-title">
      {titre} {titreRouge && <span class="tom__accent">{titreRouge}</span>}
    </h2>
    {sousTitre && <p class="shead__aside">{typo(sousTitre)}</p>}
  </header>

  <p class="tom__text" data-manifesto>
    {
      mots.map(({ mot, avant, couleur }) => (
        <Fragment>{avant}<span class:list={['tom__w', { 'tom__w--hl': couleur }]} style={couleur && `--c: ${couleur}`}>{mot}</span></Fragment>
      ))
    }
  </p>

  <div class="tom__sign" data-reveal>
    <Logo class="tom__logo" />
    <p>
      {signature && `— ${signature}`}
      {signature && signatureSuite && <br />}
      {
        apresCheveux.length ? (
          <Fragment>
            {avantCheveux}<span class="tom__cheveux">cheveux</span>{apresCheveux.join('cheveux')}
          </Fragment>
        ) : (
          signatureSuite
        )
      }
    </p>
  </div>

  {/* Le badge se colle à droite de la dernière ligne, au-dessus de la signature */}
  <Patch kind="bpm" size={118} x="82%" y="72%" rotate={8} desktopOnly />
</section>

<script>
  import { onFrame, reducedMotion } from '../scripts/ticker';

  const text = document.querySelector<HTMLElement>('[data-manifesto]');
  const words = text ? [...text.querySelectorAll<HTMLElement>('.tom__w')] : [];

  if (text && words.length) {
    if (reducedMotion.matches) {
      words.forEach((word) => word.classList.add('is-lit'));
    } else {
      let lit = -1;
      onFrame(() => {
        const rect = text.getBoundingClientRect();
        const vh = window.innerHeight;
        if (rect.bottom < -vh || rect.top > vh * 2) return;
        // 0 quand le texte entre en bas de l'écran, 1 quand sa fin remonte aux 3/4 de l'écran
        const progress = Math.min(1, Math.max(0, (vh * 0.9 - rect.top) / (rect.height + vh * 0.15)));
        const count = Math.round(progress * words.length);
        if (count === lit) return;
        lit = count;
        words.forEach((word, i) => word.classList.toggle('is-lit', i < count));
      });
    }
  }
</script>

<style>
  .tom {
    position: relative;
    padding: clamp(90px, 10vw, 150px) var(--gutter);
  }

  .tom__accent {
    color: var(--accent);
  }

  .tom__text {
    max-width: 21em;
    font-family: var(--f-display);
    font-size: clamp(32px, 5.6vw, 92px);
    font-weight: 800;
    font-stretch: 82%;
    line-height: 1.04;
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  .tom__w {
    position: relative;
    color: #34343a;
    transition: color 0.4s;
  }

  .tom__w.is-lit {
    color: var(--blanc);
  }

  .tom__w--hl {
    z-index: 0;
  }

  .tom__w--hl::before {
    content: '';
    position: absolute;
    inset: 0.06em -0.12em 0.02em;
    z-index: -1;
    background: var(--c);
    transform: scaleX(0) rotate(-1.5deg);
    transform-origin: left center;
    transition: transform 0.5s var(--ease-back);
  }

  .tom__w--hl.is-lit {
    color: var(--noir);
  }

  .tom__w--hl.is-lit::before {
    transform: scaleX(1) rotate(-1.5deg);
  }

  .tom__sign {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: clamp(36px, 5vw, 64px);
    font-size: 14px;
    color: var(--gris);
  }

  .tom__sign :global(.tom__logo) {
    width: 76px;
    flex: none;
    rotate: -10deg;
    transition: rotate 0.6s var(--ease-back);
  }

  .tom__sign:hover :global(.tom__logo) {
    rotate: 350deg;
  }

  .tom__cheveux {
    padding: 0 0.3em;
    font-weight: 700;
    color: var(--noir);
    background: var(--cheveux);
  }
</style>
