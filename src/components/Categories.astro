---
// Rayons : grandes lignes qui se remplissent de couleur au survol,
// avec un aperçu du vêtement qui suit la souris.
import type { CollectionEntry } from 'astro:content';
import Garment from './Garment.astro';
import Icon from './Icon.astro';
import { RAYONS } from '../data/catalogue';

interface Props {
  produits: CollectionEntry<'produits'>[];
}

const { produits } = Astro.props;
const rayons = RAYONS.map((rayon) => ({
  ...rayon,
  total: produits.filter((produit) => rayon.categories.includes(produit.data.categorie)).length,
}));
---

<section class="cats" aria-labelledby="cats-title">
  <header class="shead">
    <span class="shead__idx">(03)</span>
    <h2 class="shead__title" id="cats-title">Rayons</h2>
    <p class="shead__aside">Tout est noir, sauf ce qui ne l'est pas.</p>
  </header>

  <ul class="cats__list" data-cats>
    {
      rayons.map((rayon, i) => (
        <li data-reveal style={`--d: ${i * 80}`}>
          <a class="cat" href="#drop" style={`--c: var(--${rayon.couleur})`} data-cat={i} data-cursor="Voir">
            <span class="cat__idx">0{i + 1}</span>
            <span class="cat__name">{rayon.nom}</span>
            <span class="cat__count">
              {String(rayon.total).padStart(2, '0')} pièce{rayon.total > 1 ? 's' : ''}
            </span>
            <Icon name="arrow" class="cat__arrow" />
          </a>
        </li>
      ))
    }
  </ul>

  <div class="cats__preview" data-cats-preview aria-hidden="true">
    {
      rayons.map((rayon, i) => (
        <div class="cats__frame" data-frame={i} style={`--c: var(--${rayon.couleur})`}>
          <Garment type={rayon.apercu} />
        </div>
      ))
    }
  </div>
</section>

<script>
  import { finePointer, onFrame } from '../scripts/ticker';

  const list = document.querySelector<HTMLElement>('[data-cats]');
  const preview = document.querySelector<HTMLElement>('[data-cats-preview]');

  if (list && preview && finePointer.matches) {
    const frames = [...preview.querySelectorAll<HTMLElement>('[data-frame]')];
    let x = 0;
    let y = 0;
    let targetX = 0;
    let targetY = 0;
    let height = 0;
    let active = false;

    list.addEventListener('pointerenter', (e) => {
      x = targetX = e.clientX;
      y = targetY = e.clientY;
      height = preview.offsetHeight;
    });
    list.addEventListener('pointermove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;
    });
    list.querySelectorAll<HTMLElement>('[data-cat]').forEach((link) => {
      link.addEventListener('pointerenter', () => {
        frames.forEach((frame) => frame.classList.toggle('is-on', frame.dataset.frame === link.dataset.cat));
        preview.classList.add('is-on');
        active = true;
      });
    });
    list.addEventListener('pointerleave', () => {
      preview.classList.remove('is-on');
      active = false;
    });

    onFrame(() => {
      if (!active) return;
      const dx = targetX - x;
      x += dx * 0.16;
      y += (targetY - y) * 0.16;
      const tilt = Math.max(-12, Math.min(12, dx * 0.08));
      preview.style.transform = `translate3d(${x + 32}px, ${y - height / 2}px, 0) rotate(${tilt}deg)`;
    });
  }
</script>

<style>
  .cats {
    position: relative;
    padding: clamp(60px, 8vw, 120px) var(--gutter) clamp(90px, 10vw, 150px);
  }

  .cats__list {
    border-top: 2px solid var(--ligne);
  }

  .cat {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    padding: clamp(10px, 1.4vw, 18px) 12px;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 2px solid var(--ligne);
    transition: color 0.3s;
  }

  .cat::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-snap);
  }

  .cat__idx {
    font-size: 13px;
    font-weight: 700;
  }

  .cat__name {
    font-family: var(--f-display);
    font-size: clamp(52px, 9vw, 150px);
    font-weight: 900;
    font-stretch: 55%;
    line-height: 0.86;
    text-transform: uppercase;
    transition:
      font-stretch 0.6s var(--ease-out),
      translate 0.6s var(--ease-out);
  }

  .cat__count {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cat :global(.cat__arrow) {
    font-size: clamp(28px, 3vw, 44px);
    transition: transform 0.5s var(--ease-back);
  }

  @media (hover: hover) {
    .cat:hover {
      color: var(--noir);
    }

    .cat:hover::before {
      transform: scaleY(1);
    }

    .cat:hover .cat__name {
      font-stretch: 90%;
      translate: 14px 0;
    }

    .cat:hover :global(.cat__arrow) {
      transform: rotate(-45deg) scale(1.2);
    }
  }

  /* Aperçu qui suit la souris */
  .cats__preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: clamp(200px, 18vw, 280px);
    aspect-ratio: 4 / 5;
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.3s,
      scale 0.45s var(--ease-back);
  }

  .cats__preview.is-on {
    opacity: 1;
    scale: 1;
  }

  .cats__frame {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(rgb(0 0 0 / 0.2) 1.1px, transparent 1.6px) 0 0 / 7px 7px,
      var(--c);
    border: 3px solid var(--noir);
    box-shadow: 8px 8px 0 var(--blanc);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.5s var(--ease-snap);
  }

  .cats__frame.is-on {
    clip-path: inset(0 -20px -20px 0);
  }

  .cats__frame :global(.garment) {
    width: 84%;
    height: 84%;
    margin: 8%;
  }

  @media (hover: none) {
    .cats__preview {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .cat {
      grid-template-columns: 32px minmax(0, 1fr) auto;
      padding-inline: 4px;
    }

    .cat__count {
      display: none;
    }
  }
</style>
