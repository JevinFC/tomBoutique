---
// Pied de page : liens, et le nom en géant (comme le logo de l'en-tête : « TOM » en capitales,
// « Boutique » en gothique rouge) dont chaque lettre saute au survol.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { RAYONS } from '../data/catalogue';
import { site } from '../data/site';

// Premier mot en capitales, la suite en gothique ; i = rang de la lettre (apparition en cascade)
const [prenom, ...suite] = site.nom.split(' ');
let rang = 0;
const MOTS = [
  { gothique: false, texte: prenom.toUpperCase() },
  { gothique: true, texte: suite.join(' ') },
].map(({ gothique, texte }) => ({ gothique, lettres: [...texte].map((lettre) => ({ lettre, i: rang++ })) }));
const AIDE = [
  { nom: 'Livraison', href: '/cgv#livraison' },
  { nom: 'Retours', href: '/cgv#retractation' },
  { nom: 'Guide des tailles', href: '#' },
  { nom: 'Contact', href: '/mentions-legales#editeur' },
];
---

<footer class="ftr">
  <div class="ftr__cols">
    <div class="ftr__brand">
      <Logo class="ftr__logo" />
      <p>Fait dans un sous-sol, à 140 BPM, avec beaucoup trop de couleurs.</p>
    </div>
    <nav aria-label="Shop">
      <h2>Shop</h2>
      <ul>
        {
          RAYONS.map((rayon) => (
            <li>
              <a href="/#drop">{rayon.nom}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Aide">
      <h2>Aide</h2>
      <ul>
        {
          AIDE.map((lien) => (
            <li>
              <a href={lien.href}>{lien.nom}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Réseaux">
      <h2>Réseaux</h2>
      <ul>
        {
          site.reseaux.map((reseau) => (
            <li>
              <a href={reseau.url}>{reseau.nom}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <p class="ftr__giant" data-pop>
    <span class="sr-only">{site.nom}</span>
    <span class="ftr__giant-row" aria-hidden="true">
      {
        MOTS.map(({ gothique, lettres }) => (
          <span class:list={['ftr__word', gothique && 'ftr__word--gothic gothic']}>
            {lettres.map(({ lettre, i }) => (
              <span class="ftr__letter" style={`--i: ${i}`}>
                {lettre}
              </span>
            ))}
          </span>
        ))
      }
    </span>
  </p>

  <div class="ftr__bottom">
    <p>© {new Date().getFullYear()} {site.nom}</p>
    <nav class="ftr__legal" aria-label="Infos légales">
      <a href="/cgv">CGV</a>
      <a href="/mentions-legales">Mentions légales</a>
    </nav>
    <p>Prototype v0.1 — les vêtements sont des placeholders</p>
    <a href="#top">Retour en haut <Icon name="arrow" class="ftr__up" /></a>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    padding: clamp(60px, 8vw, 110px) var(--gutter) 24px;
    border-top: 2px solid var(--blanc);
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 32px;
  }

  .ftr__brand :global(.ftr__logo) {
    width: 72px;
    margin-bottom: 16px;
  }

  .ftr__brand p {
    max-width: 30ch;
    font-size: 13px;
    color: var(--gris);
  }

  .ftr h2 {
    margin-bottom: 14px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .ftr li + li {
    margin-top: 6px;
  }

  .ftr nav a {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 3px no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }

  .ftr nav a:hover {
    background-size: 100% 3px;
  }

  .ftr__giant {
    margin: clamp(48px, 8vw, 110px) 0 10px;
  }

  .ftr__giant-row {
    display: flex;
    justify-content: center;
    align-items: baseline;
    font-family: var(--f-display);
    font-size: 21vw;
    font-weight: 900;
    font-stretch: 50%;
    line-height: 0.78;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .ftr__word {
    display: flex;
  }

  /* « Boutique » en gothique rouge, à peu près à la hauteur de capitale de « TOM » */
  .ftr__word--gothic {
    margin-left: 0.1em;
    font-size: 0.9em;
    line-height: 1;
    color: var(--accent);
  }

  .ftr__letter {
    display: inline-block;
    transition:
      translate 0.9s var(--ease-back) calc(var(--i) * 45ms),
      opacity 0.5s calc(var(--i) * 45ms),
      transform 0.35s var(--ease-back),
      color 0.2s;
  }

  .ftr__letter:hover {
    color: var(--accent);
    transform: translateY(-10%) rotate(-6deg);
  }

  .ftr__word--gothic .ftr__letter:hover {
    color: var(--blanc);
  }

  :global(html.js) .ftr__letter {
    opacity: 0;
    translate: 0 60%;
  }

  :global(html.is-ready) .ftr__giant:global(.is-in) .ftr__letter,
  :global(html.is-ready:not(.motion-ok)) .ftr__letter {
    opacity: 1;
    translate: 0 0;
  }

  /* Au-dessus du nom géant : la police gothique déborde bien sous ses lettres et couvrait
     « Retour en haut » (seule la flèche restait cliquable) */
  .ftr__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 18px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gris);
    border-top: 2px solid var(--ligne);
  }

  .ftr__bottom a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--blanc);
  }

  .ftr__bottom :global(.ftr__up) {
    rotate: -90deg;
  }

  .ftr__legal {
    display: flex;
    gap: 18px;
  }

  /* Discrets comme le reste de la ligne (pas la taille des liens des colonnes) */
  .ftr__bottom .ftr__legal a {
    font-size: inherit;
    font-weight: 400;
    color: var(--blanc);
    background-size: 0 2px;
  }

  .ftr__bottom .ftr__legal a:hover {
    background-size: 100% 2px;
  }

  @media (max-width: 800px) {
    .ftr__cols {
      grid-template-columns: 1fr 1fr;
    }

    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
</style>
