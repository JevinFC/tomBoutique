---
// Lookbook : sur grand écran la section se fige et les photos défilent à l'horizontale
// pendant le scroll ; sur mobile c'est un carrousel qu'on fait glisser au doigt.
import Garment from './Garment.astro';
import Icon from './Icon.astro';
import type { Categorie } from '../data/catalogue';

// Placeholders à remplacer par les photos du shooting
const LOOKS: { legende: string; type: Categorie; rotation: number }[] = [
  { legende: 'Hoodie Fantôme, 5 h du mat', type: 'hoodie', rotation: -3 },
  { legende: 'Tee 140 BPM, devant les enceintes', type: 'tshirt', rotation: 2 },
  { legende: 'Casquette Acide, sous la pluie', type: 'casquette', rotation: -1.5 },
  { legende: 'Longsleeve Limbo, fin de set', type: 'longsleeve', rotation: 3 },
  { legende: 'Cargo Nuit blanche, au vestiaire', type: 'pantalon', rotation: -2.5 },
  { legende: 'Tote Sous-sol, retour en night bus', type: 'sac', rotation: 1.5 },
];
---

<section class="lb" id="lookbook" data-lookbook aria-labelledby="lb-title">
  <div class="lb__sticky">
    <header class="lb__head">
      <span class="shead__idx">(03)</span>
      <h2 class="lb__title" id="lb-title">Lookbook <span class="lb__season">Hiver 26</span></h2>
      <p class="lb__hint">Shooting à venir. En attendant&nbsp;: des placeholders qui ont du style.</p>
    </header>

    <div class="lb__viewport">
      <div class="lb__track" data-lb-track>
        {
          LOOKS.map((look, i) => (
            <figure class="look" style={`--rot: ${look.rotation}deg`}>
              <span class="look__tape" aria-hidden="true" />
              <div class="look__img">
                <Garment type={look.type} class="look__garment" />
                <span class="look__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="look__ph">photo à venir</span>
              </div>
              <figcaption>
                <strong>Look {String(i + 1).padStart(2, '0')}</strong> {look.legende}
              </figcaption>
            </figure>
          ))
        }
        <a class="look look--end" href="#drop" data-cursor="Go">
          <span>Tout le drop</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <div class="lb__progress" aria-hidden="true"><span data-lb-progress></span></div>
  </div>
</section>

<script>
  import { onFrame } from '../scripts/ticker';

  const section = document.querySelector<HTMLElement>('[data-lookbook]');
  const track = section?.querySelector<HTMLElement>('[data-lb-track]');
  const bar = section?.querySelector<HTMLElement>('[data-lb-progress]');

  if (section && track) {
    const pinnable = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
    let distance = 0;

    // La hauteur de la section = la distance à parcourir à l'horizontale + un écran
    const measure = () => {
      section.classList.toggle('is-pinned', pinnable.matches);
      if (!pinnable.matches) {
        section.style.removeProperty('height');
        track.style.removeProperty('transform');
        return;
      }
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      section.style.height = `${distance + window.innerHeight}px`;
    };

    measure();
    new ResizeObserver(measure).observe(track);
    window.addEventListener('resize', measure);
    pinnable.addEventListener('change', measure);

    onFrame(({ velocity }) => {
      if (!pinnable.matches) return;
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0;
      // Petit effet élastique : les photos s'inclinent selon la vitesse de scroll
      const skew = Math.max(-5, Math.min(5, velocity * -0.004));
      track.style.transform = `translate3d(${(-progress * distance).toFixed(1)}px, 0, 0) skewX(${skew.toFixed(2)}deg)`;
      if (bar) bar.style.transform = `scaleX(${progress.toFixed(3)})`;
    });
  }
</script>

<style>
  .lb {
    position: relative;
    padding-block: clamp(60px, 8vw, 110px);
  }

  .lb__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: end;
    gap: 12px 32px;
    margin: 0 var(--gutter) clamp(24px, 3vw, 40px);
    padding-top: 16px;
    border-top: 2px solid var(--blanc);
  }

  .lb__title {
    font-family: var(--f-display);
    font-size: clamp(60px, 10vw, 170px);
    font-weight: 900;
    font-stretch: 60%;
    line-height: 0.8;
    text-transform: uppercase;
  }

  .lb__season {
    font-size: 0.5em;
    color: var(--accent);
    white-space: nowrap;
  }

  .lb__hint {
    max-width: 30ch;
    font-size: 13px;
    text-align: right;
    color: var(--gris);
  }

  .lb__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .lb__viewport::-webkit-scrollbar {
    display: none;
  }

  .lb__track {
    display: flex;
    align-items: center;
    gap: clamp(24px, 3vw, 48px);
    width: max-content;
    padding: 34px var(--gutter) 40px;
  }

  .look {
    position: relative;
    flex: none;
    width: clamp(240px, 24vw, 380px);
    scroll-snap-align: center;
    rotate: var(--rot);
    transition:
      rotate 0.5s var(--ease-back),
      scale 0.5s var(--ease-back);
  }

  .look__tape {
    position: absolute;
    top: -14px;
    left: 50%;
    z-index: 2;
    width: 46%;
    height: 28px;
    translate: -50% 0;
    rotate: -4deg;
    background: color-mix(in srgb, var(--accent) 85%, transparent);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.3);
  }

  /* Photo façon photocopie : noir et blanc, trame, qui prend la couleur au survol */
  .look__img {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--photo-flash);
    border: 10px solid var(--blanc);
    filter: grayscale(1) contrast(1.1);
    transition: filter 0.5s;
  }

  .look__img::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.4s;
  }

  .look__img::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--photo-trame);
  }

  .look__img :global(.look__garment) {
    position: absolute;
    inset: 14% 12% 10%;
    width: 76%;
    height: 76%;
  }

  .look__num {
    position: absolute;
    bottom: 4px;
    left: 12px;
    z-index: 1;
    font-family: var(--f-display);
    font-size: 64px;
    font-weight: 900;
    font-stretch: 60%;
    line-height: 1;
    color: var(--blanc);
    mix-blend-mode: difference;
  }

  .look__ph {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gris);
  }

  /* Légendes en casse normale (les capitales restent pour les titres et les boutons) */
  .look figcaption {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--gris);
  }

  .look figcaption strong {
    margin-right: 8px;
    color: var(--blanc);
  }

  .look--end {
    display: grid;
    align-content: space-between;
    width: clamp(200px, 18vw, 280px);
    aspect-ratio: 3 / 4;
    padding: 22px;
    font-family: var(--f-display);
    font-size: clamp(36px, 3.6vw, 60px);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--noir);
    background: var(--accent);
    border: 3px solid var(--noir);
    box-shadow: var(--ombre) var(--ombre) 0 var(--blanc);
    --rot: 2deg;
  }

  .look--end :global(.icon) {
    font-size: 1.3em;
  }

  @media (hover: hover) {
    .look:hover {
      rotate: 0deg;
      scale: 1.04;
    }

    .look:hover .look__img {
      filter: none;
    }

    .look:hover .look__img::before {
      opacity: 1;
    }
  }

  /* --- Mode figé (grand écran) --- */

  .lb:global(.is-pinned) {
    padding-block: 0;
  }

  .lb:global(.is-pinned) .lb__sticky {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
  }

  .lb:global(.is-pinned) .lb__viewport {
    overflow: visible;
  }

  .lb:global(.is-pinned) .lb__track {
    will-change: transform;
  }

  .lb__progress {
    display: none;
  }

  .lb:global(.is-pinned) .lb__progress {
    position: relative;
    display: block;
    height: 4px;
    margin: 18px var(--gutter) 0;
    background: var(--ligne);
  }

  .lb__progress span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (max-width: 760px) {
    .lb__head {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .lb__hint {
      grid-column: 1 / -1;
      text-align: left;
    }
  }
</style>
