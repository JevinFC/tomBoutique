---
// Premier écran : slogan géant tissé lettre par lettre à l'arrivée (chaque lettre monte rang
// par rang, de bas en haut), polaroid de la pièce phare et une étoile collée sur le point de
// « DEHORS. », sur le fond façon tissu éraflé.
import type { CollectionEntry } from 'astro:content';
import Garment from './Garment.astro';
import Icon from './Icon.astro';
import Patch from './Patch.astro';
import { formatPrix } from '../data/catalogue';
import { site } from '../data/site';

interface Props {
  /** Pièce phare, affichée sur le polaroid */
  vedette: CollectionEntry<'produits'>;
}

const { vedette } = Astro.props;

// Les mots du slogan, découpés en lettres numérotées dans l'ordre de lecture :
// la lettre n° i commence à se tisser un peu après la précédente (voir --d dans le style)
const MOTS = [
  { texte: 'NOIR', classe: '' },
  { texte: 'DEHORS.', classe: 'hero__word--outline' },
  { texte: 'FLUO', classe: 'hero__word--fluo' },
  { texte: 'DEDANS.', classe: '' },
];
let numero = 0;
const mots = MOTS.map(({ texte, classe }) => ({
  classe,
  lettres: [...texte].map((lettre) => ({ lettre, i: numero++ })),
}));
const lignes = [mots.slice(0, 2), mots.slice(2)];
---

<section class="hero" aria-labelledby="hero-title">
  <h1 class="hero__title" id="hero-title">
    <span class="sr-only">{site.slogan} {site.nom}</span>
    <span class="hero__lines" aria-hidden="true">
      {
        lignes.map((ligne) => (
          <span class="hero__line">
            {ligne.map(({ classe, lettres }) => (
              <span class:list={['hero__word', classe]}>
                {lettres.map(({ lettre, i }) => (
                  <span class="hero__ch" style={`--i: ${i}`}>
                    <span class="hero__glyph">{lettre}</span>
                  </span>
                ))}
              </span>
            ))}
          </span>
        ))
      }
    </span>
  </h1>

  <div class="hero__bottom">
    <p class="hero__lede">{site.description}</p>
    <div class="hero__ctas">
      <a class="btn" href="#drop">Voir le drop <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href="#lookbook">Lookbook</a>
    </div>
  </div>

  <a class="hero__card" href={`/produits/${vedette.id}`} data-tilt data-cursor="Voir">
    <span class="hero__card-inner">
      <span class="hero__card-tape" aria-hidden="true"></span>
      <span class="hero__card-img"><Garment type={vedette.data.categorie} /></span>
      <span class="hero__card-cap">
        <span>{vedette.data.nom}</span>
        <span>{formatPrix(vedette.data.prix)}</span>
      </span>
      <span class="hero__card-badge">Pièce phare</span>
    </span>
  </a>

  {/* L'étoile se colle pile sur le point de « DEHORS. » (grand écran). Sa position est en em de
      la taille du titre (voir .hero__star) : elle suit le texte quelle que soit la largeur. */}
  <Patch
    kind="star"
    class="hero__star"
    size={84}
    x="calc(var(--gutter) + 6.18em - var(--s) / 2)"
    y="calc(var(--marge-haut) + 0.52em - var(--s) / 2)"
    rotate={12}
    delay={1400}
    desktopOnly
  />
</section>

<style>
  .hero {
    /* Début du tissage du titre, plus tard quand l'intro vient de jouer (ses bandes doivent avoir quitté l'écran) */
    --depart: 0.1s;
    /* Marge du haut et taille du titre, partagées avec l'étoile collée sur le titre */
    --marge-haut: clamp(32px, 4vw, 64px);
    --titre: clamp(76px, 14.4vw, 290px);

    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(210px, 20vw, 300px);
    grid-template-areas:
      'title title'
      'bottom card';
    /* Sur les écrans hauts, la place libre va entre le titre et le bas (composition d'affiche),
       pas en bande vide sous les boutons */
    align-content: space-between;
    gap: clamp(20px, 2.6vw, 36px) clamp(24px, 4vw, 64px);
    min-height: calc(100svh - var(--hdr-h) - 34px);
    padding: var(--marge-haut) var(--gutter) clamp(120px, 12vw, 180px);
  }

  :global(html:not(.no-intro)) .hero {
    --depart: 0.7s;
  }

  /* --- Le slogan géant --- */

  .hero__title {
    /* Réglages du tissage */
    --rangs: 10; /* rangs par lettre, en nombre pair (un aller-retour de navette = 2 rangs) */
    --rang: 50ms; /* durée d'un rang */
    --vide: 38%; /* jour entre deux rangs, avant le tassage */
    --haut: -0.02em; /* la zone tissée va du haut des capitales (qui dépasse un peu de la ligne)… */
    --bas: 0.11em; /* …à la ligne de base, un peu dessous pour le bas des lettres rondes */
    --h-rang: calc((0.8em - var(--haut) - var(--bas)) / var(--rangs)); /* 0.8em = hauteur de ligne */

    grid-area: title;
    position: relative;
    z-index: 2;
    font-family: var(--f-display);
    font-size: var(--titre);
    font-weight: 900;
    font-stretch: 86%;
    line-height: 0.8;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .hero__lines {
    position: relative;
    display: block;
  }

  .hero__line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.14em;
  }

  .hero__word {
    position: relative;
    display: inline-flex;
  }

  .hero__word--outline {
    color: transparent;
    -webkit-text-stroke: 0.022em var(--blanc);
  }

  .hero__word--fluo {
    color: var(--accent);
  }

  /* --- Le tissage : chaque lettre se tisse de bas en haut, rang par rang ---
     Les fils de chaîne (verticaux) se tendent dans la lettre, la navette passe le fil de trame
     d'un bord à l'autre (un rang vers la droite, le suivant vers la gauche), chaque rang tissé
     prend la forme de la lettre, puis les rangs sont tassés et la lettre devient pleine. */

  .hero__ch {
    --d: calc(var(--depart) + var(--i) * 45ms);
    --tissage: calc(var(--rangs) * var(--rang));

    position: relative;
    display: inline-block;
  }

  /* Le cadre de la lettre déborde de 0.1em tout autour (sans rien décaler) pour que le tissage
     ne rogne ni son contour ni le haut des capitales */
  .hero__glyph {
    display: block;
    margin: -0.1em;
    padding: 0.1em;
  }

  :global(html.js) .hero__glyph {
    clip-path: inset(0 0 100%);
  }

  :global(html.is-ready) .hero__glyph {
    clip-path: none;
    mask-position: left 0 bottom calc(0.1em + var(--bas));
    mask-size: 100% var(--h-rang);
    animation:
      hero-tisse var(--tissage) steps(var(--rangs), end) var(--d) backwards,
      hero-tasse calc(var(--tissage) / 0.7) linear var(--d) backwards;
  }

  /* Les fils de chaîne et le fil de trame n'existent que pendant l'arrivée */
  :global(html.js) .hero__ch::before,
  :global(html.js) .hero__ch::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  /* Chaîne : des fils verticaux tendus dans la lettre, recouverts rang après rang */
  :global(html.js) .hero__ch::before {
    inset: var(--haut) 0 var(--bas);
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--blanc) 30%, transparent) 0 max(1px, 0.008em),
      transparent 0 0.05em
    );
    transform: scaleY(0);
    transform-origin: top;
  }

  :global(html.is-ready) .hero__ch::before {
    transform: none;
    animation:
      hero-chaine 0.25s var(--ease-out) calc(var(--d) - 0.2s) backwards,
      hero-recouvre var(--tissage) steps(var(--rangs), end) var(--d) forwards;
  }

  /* Trame : le fil de la navette, posé sur le rang en cours, juste au-dessus de la partie tissée */
  :global(html.js) .hero__ch::after {
    right: -0.03em;
    bottom: var(--bas);
    left: -0.03em;
    height: var(--h-rang);
    background: var(--accent);
    opacity: 0;
  }

  :global(html.is-ready) .hero__ch::after {
    animation:
      hero-trame var(--tissage) steps(var(--rangs), end) var(--d),
      hero-navette calc(2 * var(--rang)) linear var(--d) calc(var(--rangs) / 2);
  }

  /* Mesuré dans le cadre de la lettre, qui commence 0.1em au-dessus de la ligne */
  @keyframes hero-tisse {
    from {
      clip-path: inset(calc(0.9em - var(--bas)) 0 0);
    }
    to {
      clip-path: inset(calc(0.1em + var(--haut)) 0 0);
    }
  }

  /* Pendant le tissage, un jour sépare les rangs ; une fois la lettre finie, le peigne tasse
     les rangs en trois coups et la lettre devient pleine */
  @keyframes hero-tasse {
    0%,
    70% {
      mask-image: linear-gradient(to top, #000 calc(100% - var(--vide)), transparent 0);
    }
    80% {
      mask-image: linear-gradient(to top, #000 calc(100% - var(--vide) * 0.6), transparent 0);
    }
    90% {
      mask-image: linear-gradient(to top, #000 calc(100% - var(--vide) * 0.25), transparent 0);
    }
    100% {
      mask-image: linear-gradient(to top, #000 100%, transparent 0);
    }
  }

  @keyframes hero-chaine {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes hero-recouvre {
    from {
      clip-path: inset(0);
    }
    to {
      clip-path: inset(0 0 100%);
    }
  }

  @keyframes hero-trame {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 1;
      transform: translateY(calc(-100% * var(--rangs)));
    }
  }

  /* La navette traverse un rang vers la droite, puis le suivant vers la gauche */
  @keyframes hero-navette {
    0% {
      clip-path: inset(var(--vide) 100% 0 0);
    }
    35%,
    50% {
      clip-path: inset(var(--vide) 0 0 0);
    }
    50.01% {
      clip-path: inset(var(--vide) 0 0 100%);
    }
    85%,
    100% {
      clip-path: inset(var(--vide) 0 0 0);
    }
  }

  /* L'étoile prend la taille du titre : ses coordonnées en em suivent les lettres */
  .hero :global(.hero__star) {
    font-size: var(--titre);
  }

  /* --- Bas du hero --- */

  .hero__bottom {
    grid-area: bottom;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 24px;
    align-self: end;
    max-width: 560px;
  }

  .hero__lede {
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.65;
    color: color-mix(in srgb, var(--blanc) 82%, transparent);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* --- Polaroid de la pièce phare --- */

  .hero__card {
    grid-area: card;
    position: relative;
    z-index: 3;
    align-self: end;
    justify-self: end;
    width: 100%;
    margin-top: clamp(-40px, -2.4vw, -16px);
  }

  .hero__card-inner {
    position: relative;
    display: block;
    padding: 12px 12px 14px;
    color: var(--noir);
    background: var(--blanc);
    box-shadow:
      0 30px 60px -20px rgb(0 0 0 / 0.9),
      var(--ombre) var(--ombre) 0 var(--accent);
    rotate: 4deg;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s var(--ease-out),
      rotate 0.5s var(--ease-back);
  }

  .hero__card-img {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--photo-trame), var(--photo-flash);
  }

  .hero__card-img :global(.garment) {
    width: 86%;
    height: 86%;
    margin: 7%;
    transition: transform 0.6s var(--ease-back);
  }

  .hero__card-cap {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__card-tape {
    position: absolute;
    top: -14px;
    left: 50%;
    z-index: 2;
    width: 120px;
    height: 32px;
    translate: -50% 0;
    rotate: -6deg;
    background: color-mix(in srgb, var(--accent) 85%, transparent);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.25);
  }

  .hero__card-badge {
    position: absolute;
    top: 22%;
    right: -18px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--noir);
    background: var(--accent);
    border: 2px solid var(--noir);
    rotate: 10deg;
  }

  @media (hover: hover) {
    .hero__card:hover .hero__card-inner {
      rotate: 0deg;
    }

    .hero__card:hover .hero__card-img :global(.garment) {
      transform: rotate(-6deg) scale(1.08);
    }
  }

  /* --- Entrée du bas du hero et du polaroid, vers la fin du tissage du titre --- */

  :global(html.js) .hero__bottom {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s var(--ease-out) calc(var(--depart) + 1.05s),
      transform 0.9s var(--ease-out) calc(var(--depart) + 1.05s);
  }

  :global(html.is-ready) .hero__bottom {
    opacity: 1;
    transform: none;
  }

  :global(html.js) .hero__card {
    opacity: 0;
    transform: translateY(40%) rotate(18deg);
    transition:
      opacity 0.4s calc(var(--depart) + 1.2s),
      transform 1s var(--ease-back) calc(var(--depart) + 1.2s);
  }

  :global(html.is-ready) .hero__card {
    opacity: 1;
    transform: none;
  }

  /* --- Mobile : un mot par ligne, polaroid au centre sous le titre --- */

  @media (max-width: 760px) {
    .hero {
      --titre: clamp(64px, 25vw, 150px);

      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'title'
        'card'
        'bottom';
      min-height: 0;
      padding-bottom: 130px;
    }

    .hero__title {
      font-stretch: 66%;
    }

    .hero__line {
      display: block;
    }

    .hero__word {
      display: flex;
    }

    .hero__card {
      justify-self: center;
      width: min(250px, 72vw);
      margin-top: 18px;
    }
  }
</style>
