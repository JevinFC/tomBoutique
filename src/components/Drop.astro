---
// Grille du drop en cours : toutes les pièces au même format, sur le même fond photo.
// Les filtres par rayon (au-dessus) remplacent l'ancienne section « Rayons ».
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';
import { RAYONS } from '../data/catalogue';
import { site } from '../data/site';
import textes from '../content/textes.json';
import { typo } from '../lib/typo';

interface Props {
  produits: CollectionEntry<'produits'>[];
}

const grille = Astro.props.produits.slice(0, 6);
const rayonDe = (produit: CollectionEntry<'produits'>) =>
  RAYONS.find((rayon) => rayon.categories.includes(produit.data.categorie))?.nom ?? '';
// Un filtre par rayon présent dans le drop
const filtres = RAYONS.map((rayon) => ({
  nom: rayon.nom,
  total: grille.filter((produit) => rayonDe(produit) === rayon.nom).length,
})).filter((filtre) => filtre.total > 0);
---

<section class="drop" id="drop" aria-labelledby="drop-title">
  <header class="shead">
    <span class="shead__idx">(01)</span>
    <h2 class="shead__title" id="drop-title">
      Drop {site.drop.numero} <span class="drop__nom gothic">{site.drop.nom}</span>
    </h2>
    <p class="shead__aside">
      {typo(textes.drop.texte.replaceAll('{pieces}', String(grille.length)))}
    </p>
  </header>

  <div class="filtres" role="group" aria-label="Filtrer par rayon" data-filtres>
    <button class="filtre" type="button" data-filtre="" aria-pressed="true">Tout <span>{grille.length}</span></button>
    {
      filtres.map(({ nom, total }) => (
        <button class="filtre" type="button" data-filtre={nom} aria-pressed="false">
          {nom} <span>{total}</span>
        </button>
      ))
    }
  </div>

  <div class="drop__grid" data-grille>
    {
      grille.map((produit, i) => (
        <div class="drop__cell" data-reveal data-rayon={rayonDe(produit)} style={`--d: ${(i % 3) * 90}`}>
          <ProductCard produit={produit} />
        </div>
      ))
    }
  </div>
</section>

<script>
  // Les boutons « Ajouter » des cartes sont gérés pour tout le site (src/scripts/panier.ts).
  // Filtres par rayon : les pièces des autres rayons sont masquées
  const filtres = document.querySelector<HTMLElement>('[data-filtres]');
  const grille = document.querySelector<HTMLElement>('[data-grille]');

  filtres?.addEventListener('click', (e) => {
    const bouton = (e.target as Element).closest<HTMLButtonElement>('[data-filtre]');
    if (!bouton || !grille) return;
    const filtre = bouton.dataset.filtre ?? '';
    filtres.querySelectorAll('[data-filtre]').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
    [...grille.children].forEach((cellule) => {
      const element = cellule as HTMLElement;
      element.hidden = filtre !== '' && element.dataset.rayon !== filtre;
    });
    // Relance la petite animation d'arrivée des pièces affichées
    grille.classList.remove('is-filtered');
    void grille.offsetWidth;
    grille.classList.add('is-filtered');
  });
</script>

<style>
  .drop {
    position: relative;
    padding: clamp(90px, 10vw, 150px) var(--gutter) clamp(80px, 9vw, 140px);
  }

  /* Le nom du drop en gothique rouge, collé de travers après le numéro */
  .drop__nom {
    display: inline-block;
    margin-left: 0.04em;
    font-size: 0.42em;
    line-height: 1;
    color: var(--accent);
    rotate: -6deg;
  }

  /* --- Filtres par rayon --- */

  .filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(28px, 3.4vw, 48px);
  }

  .filtre {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 2px solid var(--ligne);
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  .filtre span {
    font-size: 12px;
    color: var(--gris);
  }

  .filtre:hover {
    border-color: var(--blanc);
  }

  .filtre[aria-pressed='true'] {
    color: var(--noir);
    background: var(--blanc);
    border-color: var(--blanc);
  }

  .filtre[aria-pressed='true'] span {
    color: var(--noir);
  }

  /* --- Grille --- */

  .drop__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 3.4vw, 52px) clamp(16px, 2vw, 30px);
  }

  .drop__grid > [hidden] {
    display: none;
  }

  .drop__grid:global(.is-filtered) > * {
    animation: drop-in 0.5s var(--ease-back);
  }

  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }

  @media (max-width: 1000px) {
    .drop__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
