---
// Petites icônes SVG : elles prennent la couleur et la taille du texte autour.
interface Props {
  name: 'star' | 'smiley' | 'bolt' | 'arrow' | 'heart' | 'plus' | 'minus' | 'close' | 'lock';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'star' && <path fill="currentColor" d="M12 0l2.4 9.6L24 12l-9.6 2.4L12 24l-2.4-9.6L0 12l9.6-2.4z" />}
  {
    name === 'smiley' && (
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <circle cx="12" cy="12" r="10" />
        <path d="M7.6 8.4l3 3m0-3l-3 3M13.4 8.4l3 3m0-3l-3 3M7.5 15.2q4.5 4.2 9 0" />
      </g>
    )
  }
  {name === 'bolt' && <path fill="currentColor" d="M14.5 0L3 14h8l-2 10L21 9h-8.2z" />}
  {name === 'arrow' && <path fill="none" stroke="currentColor" stroke-width="2.6" d="M2 12h18M13 5l7 7-7 7" />}
  {
    name === 'heart' && (
      <path
        fill="currentColor"
        d="M12 21C5 16 2 12.5 2 8.5 2 5.5 4.3 3 7.2 3c2.1 0 3.8 1.3 4.8 3 1-1.7 2.7-3 4.8-3C19.7 3 22 5.5 22 8.5c0 4-3 7.5-10 12.5z"
      />
    )
  }
  {name === 'plus' && <path fill="none" stroke="currentColor" stroke-width="2.6" d="M4 12h16M12 4v16" />}
  {name === 'minus' && <path fill="none" stroke="currentColor" stroke-width="2.6" d="M4 12h16" />}
  {name === 'close' && <path fill="none" stroke="currentColor" stroke-width="2.6" d="M5 5l14 14M19 5L5 19" />}
  {
    name === 'lock' && (
      <g fill="none" stroke="currentColor" stroke-width="2.4">
        <rect x="4" y="10.5" width="16" height="11" />
        <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
      </g>
    )
  }
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    width: 1em;
    height: 1em;
    vertical-align: -0.12em;
  }
</style>
