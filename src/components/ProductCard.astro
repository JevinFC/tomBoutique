---
// Carte produit : toute la carte mène à la fiche. Sans photo, une silhouette placeholder
// s'affiche sur le fond photo commun (fond noir, flash, trame) ; le rouge ne sert qu'au prix
// et au badge. Les pièces à taille unique s'ajoutent au panier depuis la grille, les autres
// se choisissent sur la fiche.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Garment from './Garment.astro';
import Icon from './Icon.astro';
import { formatPrix } from '../data/catalogue';
import { trouverPhoto } from '../lib/photos';

interface Props {
  produit: CollectionEntry<'produits'>;
}

const { produit } = Astro.props;
const { nom, prix, categorie, badge, tailles, epuise } = produit.data;
const photo = trouverPhoto(produit.data.photo);
const lien = `/produits/${produit.id}`;
const tailleUnique = tailles.length === 1 ? tailles[0] : null;
---

<article class:list={['card', { 'card--soldout': epuise }]}>
  <a class="card__link" href={lien} data-cursor="Voir">
    <div class="card__media">
      <div class="card__bg"></div>
      {
        photo ? (
          <Image class="card__photo" src={photo} alt={nom} widths={[480, 960]} sizes="(max-width: 700px) 100vw, 33vw" />
        ) : (
          <Fragment>
            <Garment type={categorie} class="card__garment" />
            <span class="card__placeholder">[ photo à venir ]</span>
          </Fragment>
        )
      }
      {badge && <span class="card__badge">{badge}</span>}
      {
        epuise ? (
          <div class="card__soldout" aria-hidden="true">
            Sold out · Sold out · Sold out · Sold out
          </div>
        ) : (
          <ul class="card__sizes" aria-label="Tailles disponibles">
            {tailles.map((taille) => (
              <li>{taille}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="card__info">
      <h3 class="card__name">{nom}</h3>
      <p class="card__price">{formatPrix(prix)}</p>
      {epuise && <p class="sr-only">Épuisé</p>}
    </div>
  </a>

  {
    epuise ? (
      <a class="card__add" href="/#liste">
        <span>
          Épuisé<span class="card__add-more"> · rejoins la liste</span>
        </span>
        <Icon name="arrow" />
      </a>
    ) : tailleUnique ? (
      <button
        class="card__add"
        type="button"
        data-add-id={produit.id}
        data-add-taille={tailleUnique}
        data-add-nom={nom}
        data-cursor="+1"
      >
        <span>
          Ajouter<span class="card__add-more"> au panier</span>
        </span>
        <Icon name="arrow" />
      </button>
    ) : (
      <a class="card__add" href={lien}>
        <span>
          Choisir<span class="card__add-more"> ma taille</span>
        </span>
        <Icon name="arrow" />
      </a>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--noir-2);
    border: 2px solid var(--blanc);
    transition:
      transform 0.45s var(--ease-back),
      box-shadow 0.45s var(--ease-back);
  }

  /* Le fond commun façon photo au flash (il s'éclaire au survol) */
  .card__bg {
    position: absolute;
    inset: 0;
    background: var(--photo-trame), var(--photo-flash);
    transition: filter 0.6s var(--ease-out);
  }

  .card__media :global(.card__garment) {
    position: absolute;
    inset: 8% 9% 6%;
    width: 82%;
    height: 86%;
    transition: transform 0.6s var(--ease-back);
  }

  .card__media :global(.card__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__placeholder {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--noir);
    background: var(--accent);
    border: 2px solid var(--noir);
    rotate: 5deg;
  }

  .card__sizes {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    transform: translateY(calc(100% + 16px));
    transition: transform 0.45s var(--ease-back);
  }

  .card__sizes li {
    min-width: 36px;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
    color: var(--blanc);
    background: var(--noir);
    border: 1.5px solid var(--blanc);
  }

  .card__soldout {
    position: absolute;
    top: 46%;
    left: -20%;
    width: 140%;
    padding: 8px 0;
    font-family: var(--f-display);
    font-size: 26px;
    font-weight: 900;
    font-stretch: 70%;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--noir);
    background: var(--blanc);
    border-block: 3px solid var(--noir);
    rotate: -14deg;
  }

  .card--soldout .card__bg {
    filter: grayscale(1) brightness(0.55);
  }

  .card__info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .card__name {
    font-family: var(--f-display);
    font-size: clamp(19px, 1.7vw, 26px);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 1;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .card__price {
    flex: none;
    padding: 4px 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--noir);
    background: var(--accent);
    rotate: -3deg;
  }

  /* Bouton secondaire (contour crème), comme .btn--ghost en plus petit */
  .card__add {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 2px solid var(--blanc);
    transition:
      color 0.2s,
      background-color 0.2s,
      transform 0.35s var(--ease-back);
  }

  .card:focus-within .card__sizes {
    transform: none;
  }

  @media (hover: hover) {
    .card:hover .card__media {
      transform: translate(calc(var(--ombre) * -1), calc(var(--ombre) * -1)) rotate(-0.6deg);
      box-shadow: var(--ombre) var(--ombre) 0 var(--accent);
    }

    .card:hover .card__bg {
      filter: brightness(1.35);
    }

    .card--soldout:hover .card__bg {
      filter: grayscale(1) brightness(0.55);
    }

    .card:hover .card__media :global(.card__garment) {
      transform: rotate(-5deg) scale(1.07) translateY(-2%);
    }

    .card:hover .card__badge {
      animation: wiggle 0.5s var(--ease-back);
    }

    .card:hover .card__sizes {
      transform: none;
    }

    .card__link:hover .card__name {
      color: var(--accent);
    }

    .card__add:hover {
      color: var(--noir);
      background: var(--blanc);
      transform: rotate(-2deg) scale(1.04);
    }
  }

  @media (hover: none) {
    .card__sizes {
      transform: none;
    }
  }

  /* Petites cartes : pas de tailles par-dessus le vêtement, et le prix passe sous le nom */
  @media (max-width: 560px) {
    .card__placeholder,
    .card__sizes {
      display: none;
    }

    .card__info {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .card__add-more {
      display: none;
    }
  }
</style>
