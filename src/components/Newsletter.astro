---
// Inscription à la liste (prototype : rien n'est envoyé pour l'instant).
// Le texte vient de src/content/textes.json (interface d'administration, voir GUIDE.md).
import Patch from './Patch.astro';
import textes from '../content/textes.json';
import { typo } from '../lib/typo';
---

<section class="nl" id="liste" aria-labelledby="nl-title">
  <div class="nl__box" data-reveal>
    <p class="kicker">(04) La liste</p>
    <h2 class="nl__title" id="nl-title">Rejoins <span class="nl__accent">la liste</span></h2>
    <p class="nl__text">{typo(textes.newsletter.texte)}</p>
    <form class="nl__form" data-newsletter novalidate>
      <label class="sr-only" for="nl-email">Ton adresse e-mail</label>
      <input id="nl-email" name="email" type="email" placeholder="ton@email.fr" autocomplete="email" required />
      <button class="btn" type="submit">Je rentre</button>
    </form>
    <p class="nl__msg" data-newsletter-msg role="status"></p>
  </div>

  {/* Collé sur le coin haut droit de la carte (centrée, 980 px max), loin du texte */}
  <Patch
    kind="smiley"
    size={104}
    x="calc(min(100% - var(--gutter), 50% + 490px) - 84px)"
    y="calc(clamp(90px, 10vw, 150px) - 52px)"
    rotate={12}
    desktopOnly
  />
</section>

<script>
  import { burst } from '../scripts/fun';

  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const message = document.querySelector<HTMLElement>('[data-newsletter-msg]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>('input[type="email"]');
    if (!input || !message) return;

    if (!input.value || !input.checkValidity()) {
      message.textContent = 'Il manque un vrai e-mail.';
      message.dataset.state = 'error';
      input.focus();
      return;
    }

    // Prototype : brancher ici un vrai service d'e-mailing (Brevo, Mailchimp…) plus tard
    message.textContent = "C'est noté, t'es dans la liste. (démo : rien n'est envoyé)";
    message.dataset.state = 'ok';
    const rect = (form.querySelector('button') ?? form).getBoundingClientRect();
    burst(rect.left + rect.width / 2, rect.top + rect.height / 2, 30);
    form.reset();
  });
</script>

<style>
  .nl {
    position: relative;
    padding: clamp(90px, 10vw, 150px) var(--gutter) clamp(110px, 12vw, 170px);
  }

  .nl__box {
    position: relative;
    max-width: 980px;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 64px);
    color: var(--noir);
    background: var(--blanc);
    border: 3px solid var(--noir);
    box-shadow: var(--ombre) var(--ombre) 0 var(--accent);
    rotate: -1deg;
  }

  .nl__title {
    margin: 12px 0 18px;
    font-family: var(--f-display);
    font-size: clamp(54px, 9vw, 150px);
    font-weight: 900;
    font-stretch: 58%;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .nl__accent {
    color: var(--accent);
  }

  .nl__text {
    max-width: 46ch;
    margin-bottom: 26px;
    font-size: 15px;
  }

  .nl__form {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .nl__form input {
    flex: 1 1 260px;
    min-width: 0;
    padding: 16px 18px;
    font-size: 16px;
    font-weight: 700;
    color: var(--noir);
    background: var(--blanc);
    border: 3px solid var(--noir);
    border-radius: 0;
  }

  .nl__form input::placeholder {
    color: #8b8b8b;
  }

  .nl__form input:focus-visible {
    outline: 3px solid var(--noir);
    outline-offset: 2px;
    box-shadow: var(--ombre) var(--ombre) 0 var(--accent);
  }

  /* Sur le papier crème, l'ombre du bouton rouge passe en noir */
  .nl__form .btn {
    box-shadow: var(--ombre) var(--ombre) 0 var(--noir);
  }

  @media (hover: hover) {
    .nl__form .btn:hover {
      box-shadow: calc(var(--ombre) + 3px) calc(var(--ombre) + 3px) 0 var(--noir);
    }
  }

  .nl__msg {
    min-height: 1.6em;
    margin-top: 18px;
    font-size: 13px;
    font-weight: 700;
  }

  .nl__msg[data-state='error'] {
    color: #c4002f;
  }

  /* Mobile : la carte se redresse et garde la place de son ombre */
  @media (max-width: 700px) {
    .nl__box {
      margin-right: var(--ombre);
      rotate: 0deg;
    }
  }
</style>
