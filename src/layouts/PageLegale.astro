---
// Gabarit des pages légales (CGV, mentions légales) : titre géant comme les sections de l'accueil,
// sommaire collant à gauche sur grand écran, texte en colonne lisible à droite.
// Chaque <section> du texte est numérotée automatiquement, dans l'ordre du sommaire.
import Base from './Base.astro';
import Annonce from '../components/Annonce.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { legal } from '../data/legal';
import { site } from '../data/site';

interface Props {
  /** Titre géant de la page */
  titre: string;
  /** Nom complet (onglet du navigateur et sous-titre), si le titre est une abréviation */
  nomComplet?: string;
  description: string;
  /** Une entrée par <section id="…"> du texte, dans le même ordre */
  sommaire: { id: string; titre: string }[];
}

const { titre, nomComplet = titre, description, sommaire } = Astro.props;
---

<Base title={`${nomComplet} — ${site.nom}`} description={description}>
  <Annonce />
  <Header />

  <main id="contenu" class="legal">
    <header class="shead">
      <span class="shead__idx">(Légal)</span>
      <h1 class="shead__title">{titre}</h1>
      <p class="shead__aside">
        {nomComplet !== titre && <Fragment>{nomComplet}<br /></Fragment>}
        Dernière mise à jour&nbsp;: {legal.miseAJour}
      </p>
    </header>

    <div class="legal__grille">
      <nav class="legal__sommaire" aria-labelledby="sommaire-titre">
        <p class="legal__sommaire-titre" id="sommaire-titre">Sommaire</p>
        <ol>
          {
            sommaire.map(({ id, titre }) => (
              <li>
                <a href={`#${id}`}>{titre}</a>
              </li>
            ))
          }
        </ol>
      </nav>

      <article class="legal__texte">
        <slot />
      </article>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .legal {
    padding: clamp(48px, 7vw, 110px) var(--gutter) clamp(90px, 10vw, 150px);
  }

  .legal__grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  /* --- Sommaire --- */

  .legal__sommaire {
    padding: 18px 20px;
    border: 2px solid var(--ligne);
  }

  .legal__sommaire-titre {
    margin-bottom: 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .legal__sommaire ol {
    display: grid;
    gap: 9px;
    counter-reset: sommaire;
  }

  .legal__sommaire li {
    display: flex;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    counter-increment: sommaire;
  }

  .legal__sommaire li::before {
    content: counter(sommaire, decimal-leading-zero);
    flex: none;
    color: var(--accent);
  }

  /* Même soulignement rouge que les liens du pied de page */
  .legal__sommaire a {
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }

  .legal__sommaire a:hover {
    background-size: 100% 2px;
  }

  /* --- Texte --- */

  .legal__texte {
    counter-reset: section;
  }

  .legal__texte :global(section) {
    padding-top: 22px;
    border-top: 2px solid var(--ligne);
    counter-increment: section;
  }

  .legal__texte :global(section + section),
  .legal__texte :global(.legal__bref + section) {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .legal__texte :global(h2) {
    margin-bottom: 18px;
    font-family: var(--f-display);
    font-size: clamp(28px, 3.6vw, 48px);
    font-weight: 900;
    font-stretch: 70%;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .legal__texte :global(h2::before) {
    content: counter(section, decimal-leading-zero) ' ';
    color: var(--accent);
  }

  .legal__texte :global(h3) {
    margin: 26px 0 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .legal__texte :global(p),
  .legal__texte :global(li),
  .legal__texte :global(dd) {
    font-size: 15px;
    line-height: 1.7;
  }

  .legal__texte :global(:is(p, ul, dl) + :is(p, ul, dl, .legal__encadre)) {
    margin-top: 12px;
  }

  .legal__texte :global(ul) {
    display: grid;
    gap: 8px;
  }

  .legal__texte :global(ul > li) {
    position: relative;
    padding-left: 1.5em;
  }

  .legal__texte :global(ul > li::before) {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .legal__texte :global(a) {
    text-decoration: underline 2px var(--accent);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .legal__texte :global(.legal__note) {
    font-size: 13px;
    color: var(--gris);
  }

  /* Fiche d'identité (vendeur, hébergeur) : libellé à gauche, valeur à droite */
  .legal__texte :global(dl) {
    display: grid;
    grid-template-columns: minmax(0, 13em) minmax(0, 1fr);
    gap: 10px 20px;
  }

  .legal__texte :global(dt) {
    padding-top: 0.2em;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gris);
  }

  /* « En bref » : le résumé, sur papier crème comme le récap du panier */
  .legal__texte :global(.legal__bref) {
    padding: 22px 24px;
    color: var(--noir);
    background: var(--blanc);
    border: 3px solid var(--noir);
    box-shadow: var(--ombre) var(--ombre) 0 var(--accent);
    rotate: -0.6deg;
  }

  .legal__texte :global(.legal__bref h2) {
    font-size: clamp(24px, 2.6vw, 34px);
  }

  .legal__texte :global(.legal__bref h2::before) {
    content: none;
  }

  .legal__texte :global(.legal__bref .legal__note) {
    margin-top: 14px;
    color: #55555c;
  }

  /* Texte officiel (garantie légale) et formulaire type : encadrés */
  .legal__texte :global(.legal__encadre) {
    padding: 20px 22px;
    border: 2px solid var(--blanc);
  }

  .legal__texte :global(.legal__encadre p),
  .legal__texte :global(.legal__encadre li) {
    font-size: 14px;
  }

  .legal__texte :global(.legal__formulaire) {
    border-style: dashed;
  }

  @media (min-width: 1000px) {
    .legal__grille {
      grid-template-columns: 250px minmax(0, 74ch);
      gap: clamp(48px, 6vw, 110px);
      align-items: start;
    }

    .legal__sommaire {
      position: sticky;
      top: calc(var(--hdr-h) + 24px);
      padding: 0;
      border: 0;
    }
  }

  @media (max-width: 560px) {
    .legal__texte :global(dl) {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .legal__texte :global(dd + dt) {
      margin-top: 12px;
    }
  }
</style>
