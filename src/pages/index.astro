---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Annonce from '../components/Annonce.astro';
import Drop from '../components/Drop.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Loader from '../components/Loader.astro';
import Lookbook from '../components/Lookbook.astro';
import Manifesto from '../components/Manifesto.astro';
import Newsletter from '../components/Newsletter.astro';
import NextDrop from '../components/NextDrop.astro';
import Tape from '../components/Tape.astro';
import { site } from '../data/site';

// Les vêtements viennent de src/content/produits/*.md (un fichier par pièce)
const produits = (await getCollection('produits')).sort((a, b) => a.data.ordre - b.data.ordre);
const aLaUne = produits.filter((produit) => produit.data.alaune);
---

<Base>
  <Loader />

  <Annonce />

  <Header />

  <main id="contenu">
    <Hero vedette={aLaUne[0]} />

    <div class="tapes-x" aria-hidden="true">
      <Tape items={site.bandes.hero} angle={-3} direction={-1} speed={70} icon="star" />
    </div>

    <Drop produits={aLaUne} />
    <Manifesto />

    <div class="tapes-x" aria-hidden="true">
      <Tape items={site.bandes.prochainDrop} angle={2.5} direction={1} speed={60} icon="heart" />
    </div>

    <NextDrop />
    <Lookbook />
    <Newsletter />
  </main>

  <Footer />
</Base>
