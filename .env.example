# Paiement Stripe en MODE TEST (aucun vrai débit). Copie ce fichier en .env et remplis-le.
# Clé secrète de test : dashboard.stripe.com → Développeurs → Clés API (mode test activé).
# Le prototype refuse les clés « live » (sk_live_…).
STRIPE_SECRET_KEY=

# Facultatif : secret du webhook, affiché par la commande
#   stripe listen --forward-to localhost:4321/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Une fois le site en ligne seulement : son adresse publique (ex. https://tomboutique.fr)
SITE_URL=
